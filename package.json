{
  "name": "figma-bridge-mcp",
  "version": "0.8.0",
  "description": "Local MCP server for inspecting and editing Figma Desktop through an authenticated localhost plugin bridge.",
  "type": "module",
  "bin": {
    "figma-bridge-mcp": "src/server.js"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "skills",
    "src",
    "engine/src",
    "engine/package.json",
    "engine/LICENSE",
    "plugin",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "UPSTREAM_PROVENANCE.json",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiUweHella/figma-bridge-mcp.git"
  },
  "homepage": "https://github.com/KaiUweHella/figma-bridge-mcp#readme",
  "bugs": {
    "url": "https://github.com/KaiUweHella/figma-bridge-mcp/issues"
  },
  "keywords": [
    "figma",
    "figma-mcp",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "design-to-code",
    "code-to-figma",
    "figma-components",
    "design-system",
    "figma-plugin",
    "agent-plugin",
    "claude-code",
    "codex",
    "cursor",
    "ai",
    "claude"
  ],
  "scripts": {
    "start": "node src/server.js",
    "check:contracts": "npm run check:contracts:host && npm run check:contracts:plugin",
    "check:contracts:host": "tsc -p jsconfig.contracts.host.json",
    "check:contracts:plugin": "tsc -p jsconfig.contracts.plugin.json",
    "check:audit": "npm audit --omit=dev",
    "check:audit:development": "npm audit --include=dev --audit-level=high",
    "check:package-artifact": "node scripts/verify-package-artifact.js",
    "check:plugin": "node scripts/sync-plugin-artifact.js --check",
    "check:plugin-compatibility": "node scripts/check-plugin-compatibility.js --check",
    "check:release": "node scripts/sync-release-version.js --check",
    "check:workflow-evals": "node scripts/validate-workflow-evals.js",
    "check:fidelity-corpus": "node scripts/validate-fidelity-corpus.js",
    "check:fidelity-comparisons": "node scripts/validate-fidelity-comparisons.js",
    "check:architecture-latency": "node scripts/check-architecture-latency.js",
    "check:runtime-budgets": "node scripts/check-runtime-budgets.js",
    "accept:runtime-soak": "node scripts/runtime-soak.js",
    "check:public-safety": "node scripts/check-public-safety.js",
    "check:public-safety:staged": "node scripts/check-public-safety.js --staged",
    "check:public-safety:history": "node scripts/check-public-safety.js --history",
    "check:public-safety:push": "node scripts/check-public-safety.js --pre-push",
    "measure:architecture": "node scripts/measure-architecture-budgets.js",
    "measure:runtime": "node scripts/measure-runtime-workloads.js",
    "measure:runtime:mcp": "node scripts/measure-mcp-runtime.js",
    "probe:figma-runtime-metadata": "node scripts/probe-figma-runtime-metadata.js",
    "build:package-artifact": "node scripts/verify-package-artifact.js",
    "sync:release-version": "node scripts/sync-release-version.js",
    "sync:plugin": "node scripts/sync-plugin-artifact.js",
    "sync:plugin-compatibility": "node scripts/check-plugin-compatibility.js --record",
    "prepare:plugin-imports": "node scripts/prepare-plugin-imports.js",
    "test": "npm run check:contracts && npm run check:release && npm run check:plugin && npm run check:plugin-compatibility && npm run check:workflow-evals && npm run check:fidelity-corpus && npm run check:fidelity-comparisons && npm run check:runtime-budgets && node --test",
    "prepublishOnly": "npm run check:public-safety && npm test && npm run check:package-artifact",
    "prepare": "husky"
  },
  "dependencies": {
    "@figma/plugin-typings": "1.136.0",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18.14.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Kai-Uwe Hella",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.9.8",
    "typescript": "^5.9.3"
  }
}
