{
  "name": "figma-bridge-mcp",
  "version": "0.4.0",
  "description": "Self-contained MCP server for controlling Figma locally via a vendored Safe-Mode engine plus a plugin access key. Efficiency of a CLI bridge, security of a hardened local plugin socket. No Figma API token required.",
  "type": "module",
  "bin": {
    "figma-bridge-mcp": "src/server.js"
  },
  "main": "src/server.js",
  "files": [
    "src",
    "engine/src",
    "engine/package.json",
    "engine/LICENSE",
    "plugin",
    "docs",
    "CONTEXT.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiUweHella/figma-bridge-mcp.git"
  },
  "homepage": "https://github.com/KaiUweHella/figma-bridge-mcp#readme",
  "bugs": {
    "url": "https://github.com/KaiUweHella/figma-bridge-mcp/issues"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "design-to-code",
    "figma-plugin",
    "ai",
    "claude"
  ],
  "scripts": {
    "start": "node src/server.js",
    "check:contracts": "tsc -p jsconfig.contracts.json",
    "check:architecture-latency": "node scripts/check-architecture-latency.js",
    "measure:architecture": "node scripts/measure-architecture-budgets.js",
    "test": "npm run check:contracts && node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "ws": "^8.16.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@figma/plugin-typings": "^1.133.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
