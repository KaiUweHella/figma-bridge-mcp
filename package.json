{
  "name": "figma-safe-mcp",
  "version": "0.2.0",
  "description": "Self-contained MCP server for controlling Figma locally via a vendored Safe-Mode engine plus a plugin access key. Efficiency of figma-cli, security of a hardened plugin bridge. No Figma API token.",
  "type": "module",
  "bin": {
    "figma-safe-mcp": "src/server.js"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test engine/tests/*.test.js tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "jpeg-js": "^0.4.4",
    "ora": "^8.0.0",
    "pngjs": "^7.0.0",
    "ws": "^8.16.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
