{
  "name": "Figma Bridge Local Development",
  "id": "figma-bridge-mcp-local-development",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "capabilities": [],
  "permissions": ["teamlibrary"],
  "enableProposedApi": false,
  "enablePrivatePluginApi": true,
  "editorType": ["figma", "figjam", "slides"],
