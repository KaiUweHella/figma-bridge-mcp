    "allowedDomains": ["ws://localhost:3460", "http://localhost:3460"],
    "devAllowedDomains": ["ws://localhost:3460", "http://localhost:3460"],
    "reasoning": "Local source-checkout daemon only (loopback WebSocket on the isolated development port); no external exfiltration possible."
  }
}
