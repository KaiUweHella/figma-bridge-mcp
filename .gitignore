node_modules/
.DS_Store
*.log
.claude/
.env
.env.*
!.env.example
.npmrc
.public-safety-denylist
# downloaded by figma_run ["api","setup"] (offline API docs; machine-local)
engine/docs/
# local working docs (plans, reports, scratch)
docs-local/
# Round-trip acceptance fixtures reproduce a private Figma file: they carry a
# bare file key, component keys and real screen copy. They belong under
# docs-local/evals/, never in the repository or the npm artifact.
evals/roundtrip/
# generated only by explicit package/release verification
release-artifact/
package-smoke/
*.tgz
# Generated Figma-importable bundles. The canonical release manifest remains
# tracked at plugin/manifest.json; local and Dev Mode adapters need their own
# directory because Figma only imports files named exactly manifest.json.
plugin/local/
plugin/dev-mode/
